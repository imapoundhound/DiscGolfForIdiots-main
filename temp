@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$REPO_ROOT"
+
+FLUTTER_BIN="$(command -v flutter || true)"
+if [ -z "$FLUTTER_BIN" ]; then
+  echo "Flutter is not installed or not on PATH." >&2
+  exit 1
+fi
+FLUTTER_SDK="$(dirname "$(dirname "$(readlink -f "$FLUTTER_BIN")")")"
+
+ANDROID_SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
+if [ -z "$ANDROID_SDK" ]; then
+  for candidate in "$HOME/Android/Sdk" "$HOME/Library/Android/sdk" "/usr/local/share/android-sdk"; do
+    if [ -d "$candidate" ]; then
+      ANDROID_SDK="$candidate"
+      break
+    fi
+  done
+fi
+
+if [ -z "$ANDROID_SDK" ] || [ ! -d "$ANDROID_SDK" ]; then
+  echo "Android SDK not found. Install it first, then rerun this script." >&2
+  exit 1
+fi
+
+mkdir -p android
+cat > android/local.properties <<PROPS
+sdk.dir=$ANDROID_SDK
+flutter.sdk=$FLUTTER_SDK
+flutter.buildMode=debug
+flutter.versionName=1.0.0
+flutter.versionCode=1
+PROPS
+
+flutter config --android-sdk "$ANDROID_SDK"
+flutter pub get
+
+echo "Wrote android/local.properties"
+echo "Flutter SDK: $FLUTTER_SDK"
+echo "Android SDK: $ANDROID_SDK"
+echo "Next: flutter doctor --android-licenses && flutter doctor --verbose && flutter build apk --debug"
